{
  "name": "@ceritahmt/opencode-as",
  "version": "1.0.7",
  "description": "OpenCode OpenAI / ChatGPT account switcher for multi-account workflows",
  "type": "module",
  "bin": {
    "opencode-as": "dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./server": "./dist/src/server-plugin.js",
    "./tui": "./dist/src/tui-plugin.js"
  },
  "oc-plugin": [
    [
      "server",
      {}
    ],
    [
      "tui",
      {}
    ]
  ],
  "files": [
    "dist/src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceritahmt/opencode-account-switcher.git"
  },
  "homepage": "https://github.com/ceritahmt/opencode-account-switcher#readme",
  "bugs": {
    "url": "https://github.com/ceritahmt/opencode-account-switcher/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "as": "npm run build --silent && node dist/src/cli.js"
  },
  "keywords": [
    "opencode",
    "openai",
    "chatgpt",
    "account-switcher",
    "multi-account",
    "auth",
    "profiles"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.3",
    "@opentui/core": "^0.4.2",
    "@opentui/solid": "^0.4.2",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
