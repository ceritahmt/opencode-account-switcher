{
  "name": "@ceritahmt/opencode-as",
  "version": "1.0.0",
  "description": "OpenCode OpenAI / ChatGPT account switcher for multi-account workflows",
  "type": "module",
  "bin": {
    "opencode-as": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "as": "npm run build --silent && node dist/src/cli.js"
  },
  "keywords": [
    "opencode",
    "openai",
    "chatgpt",
    "account-switcher",
    "multi-account",
    "auth",
    "profiles"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
